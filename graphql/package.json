{
  "name": "seminario-biblioteca-graphql",
  "version": "1.0.0",
  "private": true,
  "description": "Biblioteca GraphQL con TypeScript, validación, paginación y DataLoader",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "dataloader": "^2.2.3",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.15.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
